FINOPS_MODEL_PROVIDER=copilot
COPILOT_GITHUB_TOKEN=
COPILOT_MODEL=gpt-6-astra

# Optional local OpenTelemetry JSONL file. Empty disables runtime tracing.
# Relative paths use the process working directory; message/tool content is off.
# Example: FINOPS_OTEL_FILE=workshop-output/copilot-trace.jsonl
FINOPS_OTEL_FILE=

# Optional hosted batch export: azure-monitor. Empty keeps local labs Azure-free.
# Requires the host's APPLICATIONINSIGHTS_CONNECTION_STRING. Do not set both modes.
FINOPS_OTEL_EXPORTER=

# Foundry API-key mode: FINOPS_MODEL_PROVIDER=foundry-key.
# Azure resource/project root, or a complete /openai/v1 or /v1 base URL.
# OpenAI-compatible endpoints must include /v1 and support the Responses API.
# MODEL_NAME is the Azure deployment name, not the GitHub Copilot model ID.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
MODEL_NAME=

# Foundry identity mode: FINOPS_MODEL_PROVIDER=foundry-identity; no API key needed.
# AZURE_OPENAI_ENDPOINT also accepts a Foundry project endpoint.
# Hosted agents can use the platform-injected project endpoint when this is empty.

# Restart the demo after switching providers; mock state and role links reset.
FINOPS_BACKEND=mock
FINOPS_DATA_DIR=
