FINOPS_MODEL_PROVIDER=copilot
COPILOT_GITHUB_TOKEN=
COPILOT_MODEL=gpt-5

# Optional: python -m finops_agent copilot-usage --live
# Reads this token's real account quota even with mock data; no model call.

# Foundry API-key mode: FINOPS_MODEL_PROVIDER=foundry-key.
# Resource root (https://<resource>.openai.azure.com) or full /openai/v1 base URL.
# MODEL_NAME is the Azure deployment name, not the GitHub Copilot model ID.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
MODEL_NAME=

# Foundry identity mode: FINOPS_MODEL_PROVIDER=foundry-identity; no API key needed.
# AZURE_OPENAI_ENDPOINT also accepts a Foundry project endpoint.
# Hosted agents can use the platform-injected project endpoint when this is empty.

# Restart the demo after switching providers; mock state and role links reset.
FINOPS_BACKEND=mock
FINOPS_DATA_DIR=
