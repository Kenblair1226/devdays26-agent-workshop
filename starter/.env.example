FINOPS_MODEL_PROVIDER=copilot
COPILOT_GITHUB_TOKEN=
COPILOT_MODEL=gpt-5

# For API-key BYOK, set FINOPS_MODEL_PROVIDER=foundry-key
# and COPILOT_MODEL to the model deployment name.
FOUNDRY_MODEL_URL=
FOUNDRY_API_KEY=

# Optional Lab 3 model switch: FINOPS_MODEL_PROVIDER=foundry-identity.
# Use a pre-authorized developer identity locally, Managed Identity when hosted.
# Supply the project root endpoint (no /openai/v1 suffix) and deployment name.
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# Restart the demo after switching providers; mock state and role links reset.
FINOPS_BACKEND=mock
FINOPS_DATA_DIR=
