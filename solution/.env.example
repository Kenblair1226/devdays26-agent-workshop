# GitHub Copilot authentication for local or hosted execution.
FINOPS_MODEL_PROVIDER=copilot
COPILOT_GITHUB_TOKEN=
COPILOT_MODEL=gpt-5

# Foundry API-key mode: FINOPS_MODEL_PROVIDER=foundry-key.
# Resource root (https://<resource>.openai.azure.com) or full /openai/v1 base URL.
# MODEL_NAME is the Azure deployment name, not the GitHub Copilot model ID.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
MODEL_NAME=

# Hosted default: FINOPS_MODEL_PROVIDER=foundry-identity; no API key needed.
# Locally use a pre-authorized developer identity, Managed Identity when hosted.
# AZURE_OPENAI_ENDPOINT also accepts a Foundry project endpoint.
# Hosted agents can use the platform-injected project endpoint when this is empty.

# Restart after provider changes; demo state and role links reset.
# Mock data is the safe default.
FINOPS_BACKEND=mock
# Leave empty to use the packaged synthetic data.
FINOPS_DATA_DIR=

# Instructor-only real GitHub adapter.
GITHUB_ORG=
GITHUB_ADMIN_TOKEN=
FINOPS_ALLOW_REAL_WRITES=false
FINOPS_DEPARTMENT_MAPPING=
