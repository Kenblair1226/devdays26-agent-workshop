# GitHub Copilot authentication for local or hosted execution.
FINOPS_MODEL_PROVIDER=copilot
COPILOT_GITHUB_TOKEN=
COPILOT_MODEL=gpt-5

# Set FINOPS_MODEL_PROVIDER=foundry-key to use API-key BYOK.
# COPILOT_MODEL must then be the Azure deployment name.
FOUNDRY_MODEL_URL=
FOUNDRY_API_KEY=

# Optional Lab 3 model switch / Hosted default: foundry-identity.
# Locally use a pre-authorized developer identity, Managed Identity when hosted.
# Project root endpoint (no /openai/v1); injected by Foundry when hosted.
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# Restart after provider changes; demo state and role links reset.
# Mock data is the safe default.
FINOPS_BACKEND=mock
# Leave empty to use the packaged synthetic data.
FINOPS_DATA_DIR=

# Instructor-only real GitHub adapter.
GITHUB_ORG=
GITHUB_ADMIN_TOKEN=
FINOPS_ALLOW_REAL_WRITES=false
FINOPS_DEPARTMENT_MAPPING=
